# Salin jadi .env.local lalu isi. Tanpa file ini app tetap jalan
# memakai konten lokal (mode F0).

# --- Supabase ---
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service role HANYA untuk pipeline publish (jangan pernah NEXT_PUBLIC)
SUPABASE_SERVICE_ROLE_KEY=

# --- Analytics (PostHog) ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

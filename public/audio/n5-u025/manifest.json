  "items": [
    {
      "file": "d00.mp3",
      "text": "まいにちこうえんではしります。けんこうによいとおもいます。",
      "speaker_id": 12,
      "hash": "ee2472205098c5f7"
    },
    {
      "file": "d01.mp3",
      "text": "すごいですね。わたしもうんどうしたほうがいいでしょう。",
      "speaker_id": 2,
      "hash": "a7b055cceb182d1e"
    },
    {
      "file": "d02.mp3",
      "text": "あしたいっしょにはしりませんか。あさろくじにあいましょう。",
      "speaker_id": 12,
      "hash": "c6db2d2c8cb940ed"
    },
    {
      "file": "d03.mp3",
      "text": "いいですね。でもあしたはあめがふるでしょう。",
      "speaker_id": 2,
      "hash": "127c3b03ad9e3a6b"
    },
    {
      "file": "d04.mp3",
      "text": "じゃあ、テレビでサッカーをみましょう。にほんのチームがかちそうです。",
      "speaker_id": 12,
      "hash": "969357773a24d253"
    },
    {
      "file": "d05.mp3",
      "text": "たのしみですね。ビールものみましょうか。",
      "speaker_id": 2,
      "hash": "44eec28b44bbae34"
    },
    {
      "file": "d06.mp3",
      "text": "すみません、おさけはのみません。おちゃにします。",
      "speaker_id": 12,
      "hash": "0b280a27a23c0d15"
    },
    {
      "file": "v00t.mp3",
      "text": "公園",
      "speaker_id": 2,
      "hash": "9d8308075426420c"
    },
    {
      "file": "v00x.mp3",
      "text": "こうえんではしります。",
      "speaker_id": 2,
      "hash": "241fee0b082a0d01"
    },
    {
      "file": "v01t.mp3",
      "text": "走る",

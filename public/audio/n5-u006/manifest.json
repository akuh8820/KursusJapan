      "hash": "17ac7b1c14730650"
    },
    {
      "file": "d05.mp3",
      "text": "だいじょうぶです。でも、インターネットはありますか。",
      "speaker_id": 12,
      "hash": "302b2bf6c3ad60fe"
    },
    {

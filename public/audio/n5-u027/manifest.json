  "items": [
    {
      "file": "d00.mp3",
      "text": "きのうコンビニのめんせつをうけました。",
      "speaker_id": 12,
      "hash": "2278473513eb3fcd"
    },
    {
      "file": "d01.mp3",
      "text": "どうでしたか。うかりましたか。",

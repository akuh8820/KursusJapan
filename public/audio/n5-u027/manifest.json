      "speaker_id": 2,
      "hash": "697eff6517695c52"
    },
    {
      "file": "v00x.mp3",
      "text": "コンビニではたらきます。",
      "speaker_id": 2,
      "hash": "03f40d5848b0b6ce"
    },
    {
      "file": "v01t.mp3",
      "text": "面接",

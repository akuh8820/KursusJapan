  "dialog": {
    "title_id": "Rian belajar di perpustakaan kampus, ketemu Mina",
    "lines": [
      {
        "speaker": "Mina",
        "jp": "りあんさん、いまなにをしていますか。",
        "kana": "りあんさん、いまなにをしていますか。",
        "romaji": "Rian-san, ima nani o shite imasu ka.",
        "id": "Rian, lagi apa?"
      },
      {
        "speaker": "Rian",
        "jp": "にほんごをべんきょうしています。",
        "kana": "にほんごをべんきょうしています。",
        "romaji": "Nihongo o benkyou shite imasu.",
        "id": "Saya lagi belajar bahasa Jepang."
      },
      {
        "speaker": "Mina",
        "jp": "いつもとしょかんでべんきょうしていますね。",
        "kana": "いつもとしょかんでべんきょうしていますね。",
        "romaji": "Itsumo toshokan de benkyou shite imasu ne.",
        "id": "Selalu belajar di perpustakaan ya."
      },
      {
        "speaker": "Rian",
        "jp": "はい。おんがくをききながら、べんきょうします。",
        "kana": "はい。おんがくをききながら、べんきょうします。",
        "romaji": "Hai. Ongaku o kikinagara, benkyou shimasu.",
        "id": "Ya. Sambil dengerin musik, belajar."
      },
      {
        "speaker": "Mina",
        "jp": "わたしはあした、しけんがあります。いま、しょくじをしています。",
        "kana": "わたしはあした、しけんがあります。いま、しょくじをしています。",
        "romaji": "Watashi wa ashita, shiken ga arimasu. Ima, shokuji o shite imasu.",
        "id": "Saya besok ujian. Sekarang lagi makan."
      },
      {
        "speaker": "Rian",
        "jp": "がんばってください。しょくじのあと、いっしょにべんきょうしましょうか。",
        "kana": "がんばってください。しょくじのあと、いっしょにべんきょうしましょうか。",
        "romaji": "Ganbatte kudasai. Shokuji no ato, issho ni benkyou shimashou ka.",
        "id": "Semangat ya. Setelah makan, belajar bareng yuk?"
      },
      {
        "speaker": "Mina",
        "jp": "いいですね。じゃ、あとで。",
        "kana": "いいですね。じゃ、あとで。",
        "romaji": "Ii desu ne. Jya, ato de.",
        "id": "Bagus. Ya nanti aja."
      }
    ]
  },

  "dialog": {
    "title_id": "Rian mencari toilet dan peron di stasiun",
    "lines": [
      {
        "speaker": "Rian",
        "jp": "すみません、トイレはどこですか。",
        "kana": "すみません、といれはどこですか。",
        "romaji": "Sumimasen, toire wa doko desu ka.",
        "id": "Permisi, di mana toiletnya?"
      },
      {
        "speaker": "Ekiin",
        "jp": "あそこです。エスカレーターのしたです。",
        "kana": "あそこです。えすかれーたーのしたです。",
        "romaji": "Asoko desu. Esukareetaa no shita desu.",
        "id": "Di sana. Di bawah eskalator."
      },
      {
        "speaker": "Rian",
        "jp": "ありがとうございます。えきへのきっぷはどこで買いますか。",
        "kana": "ありがとうございます。えきへのきっぷはどこでかいますか。",
        "romaji": "Arigatou gozaimasu. Eki e no kippu wa doko de kaimasu ka.",
        "id": "Terima kasih. Beli tiket ke stasiun di mana?"
      },
      {
        "speaker": "Ekiin",
        "jp": "あの自販機です。ここからまっすぐ行ってください。",
        "kana": "あのじはんきです。ここからまっすぐいってください。",
        "romaji": "Ano jihanki desu. Koko kara massugu itte kudasai.",
        "id": "Di mesin penjual otomatis itu. Dari sini jalan lurus saja."
      },
      {
        "speaker": "Rian",
        "jp": "ここですか。",
        "kana": "ここですか。",
        "romaji": "Koko desu ka.",
        "id": "Di sini ya?"
      },
      {
        "speaker": "Ekiin",
        "jp": "いいえ、そこではありません。もっとあそこです。",
        "kana": "いいえ、そこではありません。もっとあそこです。",
        "romaji": "Iie, soko de wa arimasen. Motto asoko desu.",
        "id": "Bukan di situ. Lebih jauh ke sana."
      },
      {
        "speaker": "Rian",
        "jp": "わかりました。どうもありがとう。",
        "kana": "わかりました。どうもありがとう。",
        "romaji": "Wakarimashita. Doumo arigatou.",
        "id": "Saya paham. Terima kasih banyak."
      }
    ]
  },

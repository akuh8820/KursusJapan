  "dialog": {
    "title_id": "Rian membeli onigiri di konbini dekat kos",
    "lines": [
      {
        "speaker": "Ten'in",
        "jp": "いらっしゃいませ。",
        "kana": "いらっしゃいませ。",
        "romaji": "Irasshaimase.",
        "id": "Selamat datang."
      },
      {
        "speaker": "Rian",
        "jp": "すみません、これはいくらですか。",
        "kana": "すみません、これはいくらですか。",
        "romaji": "Sumimasen, kore wa ikura desu ka.",
        "id": "Permisi, ini harganya berapa?"
      },
      {
        "speaker": "Ten'in",
        "jp": "それですか。百三十円です。",
        "kana": "それですか。ひゃくさんじゅうえんです。",
        "romaji": "Sore desu ka. Hyaku-sanjuu en desu.",
        "id": "Yang itu ya. Seratus tiga puluh yen."
      },
      {
        "speaker": "Rian",
        "jp": "じゃあ、これをください。",
        "kana": "じゃあ、これをください。",
        "romaji": "Jaa, kore o kudasai.",
        "id": "Kalau begitu, tolong yang ini."
      },
      {
        "speaker": "Ten'in",
        "jp": "はい。おふろくでよろしいですか。",
        "kana": "はい。おふろくでよろしいですか。",
        "romaji": "Hai. Ofuroku de yoroshii desu ka.",
        "id": "Baik. Dipanaskan boleh?"
      },
      {
        "speaker": "Rian",
        "jp": "はい、おねがいします。",
        "kana": "はい、おねがいします。",
        "romaji": "Hai, onegaishimasu.",
        "id": "Ya, tolong."
      },
      {
        "speaker": "Ten'in",
        "jp": "百四十円のおあずかりです。まいどありがとうございます。",
        "kana": "ひゃくよんじゅうえんのおあずかりです。まいどありがとうございます。",
        "romaji": "Hyaku-yonjuu en no oazukari desu. Maido arigatou gozaimasu.",
        "id": "Menerima seratus empat puluh yen. Terima kasih atas kunjungannya."
      }
    ]
  },

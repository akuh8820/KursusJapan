  "dialog": {
    "title_id": "Rian mengeluhkan AC bocor ke tetangga Mina",
    "lines": [
      {
        "speaker": "Rian",
        "jp": "ミナさん、ちょっとこまりました。",
        "kana": "みなさん、ちょっとこまりました。",
        "romaji": "Mina-san, chotto komarimashita.",
        "id": "Mina, saya sedikit kesulitan."
      },
      {
        "speaker": "Mina",
        "jp": "どうしたんですか。",
        "kana": "どうしたんですか。",
        "romaji": "Dou shita n desu ka.",
        "id": "Ada apa?"
      },
      {
        "speaker": "Rian",
        "jp": "エアコンがもれています。みずがおちてきます。",
        "kana": "エアコンがもれています。みずがおちてきます。",
        "romaji": "Eakon ga morete imasu. Mizu ga ochite kimasu.",
        "id": "AC bocor. Air menetes."
      },
      {
        "speaker": "Mina",
        "jp": "それはたいへんですね。やねやさんにれんらくしなければなりません。",
        "kana": "それはたいへんですね。やねやさんにれんらくしなければなりません。",
        "romaji": "Sore wa taihen desu ne. Yaneya-san ni renraku shinakereba narimasen.",
        "id": "Itu merepotkan. Harus hubungi tukang atap."
      },
      {
        "speaker": "Rian",
        "jp": "あしたれんらくします。きょうはなおしてはいけませんか。",
        "kana": "あしたれんらくします。きょうはなおしてはいけませんか。",
        "romaji": "Ashita renraku shimasu. Kyou wa naoshite wa ikemasen ka.",
        "id": "Besok saya hubungi. Hari ini jangan diperbaiki?"
      },
      {
        "speaker": "Mina",
        "jp": "じぶんでなおしてはいけません。あぶないです。",
        "kana": "じぶんでなおしてはいけません。あぶないです。",
        "romaji": "Jibun de naoshite wa ikemasen. Abunai desu.",
        "id": "Jangan diperbaiki sendiri. Berbahaya."
      },
      {
        "speaker": "Rian",
        "jp": "わかりました。やねやさんをまちます。",
        "kana": "わかりました。やねやさんをまちます。",
        "romaji": "Wakarimashita. Yaneya-san wo machimasu.",
        "id": "Baik. Saya tunggu tukang atap."
      }
    ]
  },

  "dialog": {
    "title_id": "Rian dan Yuki lihat prakiraan cuaca di TV",
    "lines": [
      {
        "speaker": "Yuki",
        "jp": "きょうのてんきはどうですか。",
        "kana": "きょうのてんきはどうですか。",
        "romaji": "Kyou no tenki wa dou desu ka.",
        "id": "Cuaca hari ini gimana?"
      },
      {
        "speaker": "Rian",
        "jp": "きょうははれです。でも、あしたはあめでしょう。",
        "kana": "きょうははれです。でも、あしたはあめでしょう。",
        "romaji": "Kyou wa hare desu. Demo, ashita wa ame deshou.",
        "id": "Hari ini cerah. Tapi besok mungkin hujan."
      },
      {
        "speaker": "Yuki",
        "jp": "きのうはくもりでしたね。",
        "kana": "きのうはくもりでしたね。",
        "romaji": "Kinou wa kumori deshita ne.",
        "id": "Kemarin berawan ya."
      },
      {
        "speaker": "Rian",
        "jp": "そうでした。きのうはさむかったです。",
        "kana": "そうでした。きのうはさむかったです。",
        "romaji": "Sou deshita. Kinou wa samukatta desu.",
        "id": "Betul. Kemarin dingin."
      },
      {
        "speaker": "Yuki",
        "jp": "あしたはかさをもっていきましょう。",
        "kana": "あしたはかさをもっていきましょう。",
        "romaji": "Ashita wa kasa o motte ikimashou.",
        "id": "Besok bawa payung ya."
      },
      {
        "speaker": "Rian",
        "jp": "はい。ふうがつよそうですから。",
        "kana": "はい。ふうがつよそうですから。",
        "romaji": "Hai. Fuu ga tsuyou sou desu kara.",
        "id": "Ya. Sepertinya anginnya kencang."
      },
      {
        "speaker": "Yuki",
        "jp": "ゆきもふるかもしれませんよ。",
        "kana": "ゆきもふるかもしれませんよ。",
        "romaji": "Yuki mo furu kamoshiremasen yo.",
        "id": "Mungkin salju juga turun."
      }
    ]
  },

  "dialog": {
    "title_id": "Rian dan Mina makan siang di kedai dekat sekolah bahasa",
    "lines": [
      {
        "speaker": "Rian",
        "jp": "ミナさん、あのめんるいは何ですか。",
        "kana": "みなさん、あのめんるいはなんですか。",
        "romaji": "Mina-san, ano menrui wa nan desu ka.",
        "id": "Mina, makanan berkuah mi yang itu apa ya?"
      },
      {
        "speaker": "Mina",
        "jp": "あれはラーメンです。とてもおいしいですよ。",
        "kana": "あれはらーめんです。とてもおいしいですよ。",
        "romaji": "Are wa raamen desu. Totemo oishii desu yo.",
        "id": "Itu ramen. Enak banget lho."
      },
      {
        "speaker": "Ten'in",
        "jp": "ごちゅうもんはおきまりですか。",
        "kana": "ごちゅうもんはおきまりですか。",
        "romaji": "Gochuumon wa okimari desu ka.",
        "id": "Sudah menentukan pesanan?"
      },
      {
        "speaker": "Rian",
        "jp": "はい。ラーメンをください。",
        "kana": "はい。らーめんをください。",
        "romaji": "Hai. Raamen o kudasai.",
        "id": "Ya. Tolong ramen."
      },
      {
        "speaker": "Mina",
        "jp": "わたしもうどんをおねがいします。",
        "kana": "わたしもうどんをおねがいします。",
        "romaji": "Watashi mo udon o onegaishimasu.",
        "id": "Saya juga tolong udon."
      },
      {
        "speaker": "Rian",
        "jp": "いただきます。……うわあ、おいしい！",
        "kana": "いただきます。……うわあ、おいしい！",
        "romaji": "Itadakimasu. ...Uwaa, oishii!",
        "id": "Aku mulai makan. ...Wow, enak!"
      },
      {
        "speaker": "Mina",
        "jp": "よかった。ごちそうさまでした。じゃあ、行きましょうか。",
        "kana": "よかった。ごちそうさまでした。じゃあ、いきましょうか。",
        "romaji": "Yokatta. Gochisousama deshita. Jaa, ikimashou ka.",
        "id": "Syukurlah. Terima kasih atas makanannya. Ayo kita pergi."
      }
    ]
  },

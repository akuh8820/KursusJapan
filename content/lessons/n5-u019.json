  "dialog": {
    "title_id": "Rian wawancara kerja part-time di kafe",
    "lines": [
      {
        "speaker": "Manager",
        "jp": "こんにちは。りあんさんですね。なぜこのバイトをしたいですか。",
        "kana": "こんにちは。りあんさんですね。なぜこのバイトをしたいですか。",
        "romaji": "Konnichiwa. Rian-san desu ne. Naze kono baito o shitai desu ka.",
        "id": "Halo. Rian ya. Kenapa mau kerja part-time di sini?"
      },
      {
        "speaker": "Rian",
        "jp": "いえちかいからです。それに、コーヒーがすきなので。",
        "kana": "いえちかいからです。それに、コーヒーがすきなので。",
        "romaji": "Ie chikai kara desu. Sore ni, koohii ga suki na node.",
        "id": "Karena dekat rumah. Dan karena saya suka kopi."
      },
      {
        "speaker": "Manager",
        "jp": "にほんごはだいじょうぶですか。",
        "kana": "にほんごはだいじょうぶですか。",
        "romaji": "Nihongo wa daijoubu desu ka.",
        "id": "Bahasa Jepangnya OK?"
      },
      {
        "speaker": "Rian",
        "jp": "すこしわかります。いま、がっこうでべんきょうしているので。",
        "kana": "すこしわかります。いま、がっこうでべんきょうしているので。",
        "romaji": "Sukoshi wakarimasu. Ima, gakkou de benkyou shite iru node.",
        "id": "Sedikit paham. Karena sekarang belajar di sekolah."
      },
      {
        "speaker": "Manager",
        "jp": "じゃ、きんようびからこれますか。",
        "kana": "じゃ、きんようびからこれますか。",
        "romaji": "Jya, kinyoubi kara koremasu ka.",
        "id": "Kalau begitu, bisa mulai Jumat?"
      },
      {
        "speaker": "Rian",
        "jp": "はい、だいじょうぶです。ありがとうございます。",
        "kana": "はい、だいじょうぶです。ありがとうございます。",
        "romaji": "Hai, daijoubu desu. Arigatou gozaimasu.",
        "id": "Ya, bisa. Terima kasih."
      },
      {
        "speaker": "Manager",
        "jp": "では、またきんようび。よろしくおねがいします。",
        "kana": "では、またきんようび。よろしくおねがいします。",
        "romaji": "Dewa, mata kinyoubi. Yoroshiku onegaishimasu.",
        "id": "Baik, Jumat lagi ya. Mohon bantuannya."
      }
    ]
  },
  "grammar": {

  "dialog": {
    "title_id": "Rian meminta nomor telepon Mina dan mencoba aplikasi baru",
    "lines": [
      {
        "speaker": "Rian",
        "jp": "ミナさん、でんわばんごうをおしえてください。",
        "kana": "みなさん、でんわばんごうをおしえてください。",
        "romaji": "Mina-san, denwa bangou wo oshiete kudasai.",
        "id": "Mina, tolong berikan nomor teleponmu."
      },
      {
        "speaker": "Mina",
        "jp": "いいですよ。ゼロ・ハチ・ゼロ・イチ・ニ・サン・ヨン・ゴ・ロク・ナナです。",
        "kana": "いいですよ。ゼロ・ハチ・ゼロ・イチ・ニ・サン・ヨン・ゴ・ロク・ナナです。",
        "romaji": "Ii desu yo. Zero hachi zero ichi ni san yon go roku nana desu.",
        "id": "Tentu saja. 080-1234-567."
      },
      {
        "speaker": "Rian",
        "jp": "ありがとう。あとでかけてみます。",
        "kana": "ありがとう。あとでかけてみます。",
        "romaji": "Arigatou. Ato de kakete mimasu.",
        "id": "Terima kasih. Nanti saya coba telpon."
      },
      {
        "speaker": "Mina",
        "jp": "このアプリをつかってみてください。べんりですよ。",
        "kana": "このアプリをつかってみてください。べんりですよ。",
        "romaji": "Kono apuri wo tsukatte mite kudasai. Benri desu yo.",
        "id": "Coba pakai aplikasi ini. Berguna kok."
      },
      {
        "speaker": "Rian",
        "jp": "ほんとうですか。ダウンロードしてみます。",
        "kana": "ほんとうですか。ダウンロードしてみます。",
        "romaji": "Hontou desu ka. Daunroodo shite mimasu.",
        "id": "Benarkah? Saya coba unduh."
      },
      {
        "speaker": "Mina",
        "jp": "ラインもいれておいてください。れんらくとりやすいです。",
        "kana": "ラインもいれておいてください。れんらくとりやすいです。",
        "romaji": "Rain mo irete oite kudasai. Renraku toriyasui desu.",
        "id": "Pasang Line juga ya. Mudah untuk kontak."
      },
      {
        "speaker": "Rian",
        "jp": "わかりました。きょううちにかえってやってみます。",
        "kana": "わかりました。きょううちにかえってやってみます。",
        "romaji": "Wakarimashita. Kyou uchi ni kaette yatte mimasu.",
        "id": "Baik. Hari ini pulang rumah saya coba lakukan."
      }
    ]
  },

  "dialog": {
    "title_id": "Rian belanja di konbini dekat kos",
    "lines": [
      {
        "speaker": "Store Staff",
        "jp": "いらっしゃいませ。",
        "kana": "いらっしゃいませ。",
        "romaji": "Irasshaimase.",
        "id": "Selamat datang."
      },
      {
        "speaker": "Rian",
        "jp": "おにぎりをひとつ、ください。",
        "kana": "おにぎりをひとつ、ください。",
        "romaji": "Onigiri o hitotsu, kudasai.",
        "id": "Onigiri satu, tolong."
      },
      {
        "speaker": "Store Staff",
        "jp": "おにぎりですね。ほかには？",
        "kana": "おにぎりですね。ほかには？",
        "romaji": "Onigiri desu ne. Hoka ni wa?",
        "id": "Onigiri ya. Ada lagi?"
      },
      {
        "speaker": "Rian",
        "jp": "おちゃをひとつ、おねがいします。",
        "kana": "おちゃをひとつ、おねがいします。",
        "romaji": "Ocha o hitotsu, onegaishimasu.",
        "id": "Teh satu, tolong."
      },
      {
        "speaker": "Store Staff",
        "jp": "おにぎりとおちゃで、ぜんぶでさんびゃくえんです。",
        "kana": "おにぎりとおちゃで、ぜんぶでさんびゃくえんです。",
        "romaji": "Onigiri to ocha de, zenbu de sanbyaku en desu.",
        "id": "Onigiri dan teh, total 300 yen."
      },
      {
        "speaker": "Rian",
        "jp": "はい。ごひゃくえんです。",
        "kana": "はい。ごひゃくえんです。",
        "romaji": "Hai. Gohyaku en desu.",
        "id": "Ya. Ini 500 yen."
      },
      {
        "speaker": "Store Staff",
        "jp": "ごひゃくえんおあずかりします。おつりはにひゃくえんです。",
        "kana": "ごひゃくえんおあずかりします。おつりはにひゃくえんです。",
        "romaji": "Gohyaku en oazukari shimasu. Otsuri wa nihyaku en desu.",
        "id": "Terima 500 yen. Kembaliannya 200 yen."
      },
      {
        "speaker": "Rian",
        "jp": "ありがとうございます。",
        "kana": "ありがとうございます。",
        "romaji": "Arigatou gozaimasu.",
        "id": "Terima kasih."
      }
    ]
  },

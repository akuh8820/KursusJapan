  "dialog": {
    "title_id": "Rian, Mina, dan Yuki ngobrol di ruang tamu kos",
    "lines": [
      {
        "speaker": "Mina",
        "jp": "りあんさん、なにがすきですか。",
        "kana": "りあんさん、なにがすきですか。",
        "romaji": "Rian-san, nani ga suki desu ka.",
        "id": "Rian, suka apa?"
      },
      {
        "speaker": "Rian",
        "jp": "えいががすきです。よくみます。",
        "kana": "えいががすきです。よくみます。",
        "romaji": "Eiga ga suki desu. Yoku mimasu.",
        "id": "Saya suka film. Sering nonton."
      },
      {
        "speaker": "Yuki",
        "jp": "わたしもえいががすきです。でも、ホラーがきらいです。",
        "kana": "わたしもえいががすきです。でも、ホラーがきらいです。",
        "romaji": "Watashi mo eiga ga suki desu. Demo, horaa ga kirai desu.",
        "id": "Saya juga suka film. Tapi tidak suka horror."
      },
      {
        "speaker": "Rian",
        "jp": "あした、えいがをみにいきたいです。いっしょにいきませんか。",
        "kana": "あした、えいがをみにいきたいです。いっしょにいきませんか。",
        "romaji": "Ashita, eiga o mi ni ikitai desu. Issho ni ikimasen ka.",
        "id": "Besok mau nonton film. Mau ikut?"
      },
      {
        "speaker": "Mina",
        "jp": "いいですね。なんのえいががみたいですか。",
        "kana": "いいですね。なんのえいががみたいですか。",
        "romaji": "Ii desu ne. Nan no eiga ga mitai desu ka.",
        "id": "Bagus. Mau nonton film apa?"
      },
      {
        "speaker": "Rian",
        "jp": "アクションがみたいです。",
        "kana": "アクションがみたいです。",
        "romaji": "Akushon ga mitai desu.",
        "id": "Mau nonton action."
      },
      {
        "speaker": "Yuki",
        "jp": "じゃ、チケットをかいましょう。",
        "kana": "じゃ、チケットをかいましょう。",
        "romaji": "Jya, chiketto o kaimashou.",
        "id": "Kalau begitu, beli tiketnya."
      }
    ]
  },

  "dialog": {
    "title_id": "Rian dan Yuki makan di restoran ramen",
    "lines": [
      {
        "speaker": "Waiter",
        "jp": "いらっしゃいませ。なんめいさまですか。",
        "kana": "いらっしゃいませ。なんめいさまですか。",
        "romaji": "Irasshaimase. Nanmei-sama desu ka.",
        "id": "Selamat datang. Berapa orang?"
      },
      {
        "speaker": "Rian",
        "jp": "ふたりです。めにゅーをください。",
        "kana": "ふたりです。めにゅーをください。",
        "romaji": "Futari desu. Menyuu o kudasai.",
        "id": "Dua orang. Tolong menunya."
      },
      {
        "speaker": "Waiter",
        "jp": "こちらです。おすすめはしょうゆラーメンです。",
        "kana": "こちらです。おすすめはしょうゆラーメンです。",
        "romaji": "Kochira desu. Osusume wa shouyu raamen desu.",
        "id": "Ini menunya. Rekomendasinya shoyu ramen."
      },
      {
        "speaker": "Yuki",
        "jp": "しょうゆラーメンがありますか。",
        "kana": "しょうゆラーメンがありますか。",
        "romaji": "Shouyu raamen ga arimasu ka.",
        "id": "Ada shoyu ramen?"
      },
      {
        "speaker": "Waiter",
        "jp": "はい、あります。ぎょうざもありますよ。",
        "kana": "はい、あります。ぎょうざもありますよ。",
        "romaji": "Hai, arimasu. Gyoza mo arimasu yo.",
        "id": "Ya, ada. Gyoza juga ada."
      },
      {
        "speaker": "Rian",
        "jp": "じゃ、しょうゆラーメンとぎょうざをください。みずがほしいです。",
        "kana": "じゃ、しょうゆラーメンとぎょうざをください。みずがほしいです。",
        "romaji": "Jya, shouyu raamen to gyoza o kudasai. Mizu ga hoshii desu.",
        "id": "Kalau begitu, shoyu ramen dan gyoza. Saya mau air putih."
      },
      {
        "speaker": "Waiter",
        "jp": "しょうゆラーメンひとつとぎょうざひとつ、みずですね。かしこまりました。",
        "kana": "しょうゆラーメンひとつとぎょうざひとつ、みずですね。かしこまりました。",
        "romaji": "Shouyu raamen hitotsu to gyoza hitotsu, mizu desu ne. Kashikomarimashita.",
        "id": "Shoyu ramen satu, gyoza satu, air ya. Baik."
      }
    ]
  },

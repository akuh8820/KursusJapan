  "dialog": {
    "title_id": "Rian wawancara kerja di konbini dan cerita ke Mina",
    "lines": [
      {
        "speaker": "Rian",
        "jp": "きのうコンビニのめんせつをうけました。",
        "kana": "きのうコンビニのめんせつをうけました。",
        "romaji": "Kinou konbini no mensetsu wo ukemashita.",
        "id": "Kemarin saya ikut wawancara di konbini."
      },
      {
        "speaker": "Mina",
        "jp": "どうでしたか。うかりましたか。",
        "kana": "どうでしたか。うかりましたか。",
        "romaji": "Dou deshita ka. Ukarimashita ka.",
        "id": "Gimana? Lolos?"
      },
      {
        "speaker": "Rian",
        "jp": "はい、うかりました。じかんぎれはきびしいのに、とおってくれました。",
        "kana": "はい、うかりました。じかんぎれはきびしいのに、とおってくれました。",
        "romaji": "Hai, ukarimashita. Jikangire wa kibishii noni, tootte kuremashita.",
        "id": "Ya, lolos. Waktu kerja ketat tapi mereka terima saya."
      },
      {
        "speaker": "Mina",
        "jp": "よかったですね。じきゅうはいくらですか。",
        "kana": "よかったですね。じきゅうはいくらですか。",
        "romaji": "Yokatta desu ne. Jikyuu wa ikura desu ka.",
        "id": "Bagus. Upah per jam berapa?"
      },
      {
        "speaker": "Rian",
        "jp": "せんえんです。ともだちがこのしごとをおしえてくれました。",
        "kana": "せんえんです。ともだちがこのしごとをおしえてくれました。",
        "romaji": "Sen en desu. Tomodachi ga kono shigoto wo oshiete kuremashita.",
        "id": "1000 yen. Teman kasih tau kerja ini."
      },
      {
        "speaker": "Mina",
        "jp": "それはやさしいともだちですね。おめでとうございます。",
        "kana": "それはやさしいともだちですね。おめでとうございます。",
        "romaji": "Sore wa yasashii tomodachi desu ne. Omedetou gozaimasu.",
        "id": "Teman baik ya. Selamat."
      },
      {
        "speaker": "Rian",
        "jp": "ありがとう。らいしゅうからはたらきます。がんばります。",
        "kana": "ありがとう。らいしゅうからはたらきます。がんばります。",
        "romaji": "Arigatou. Raishuu kara hatarakimasu. Ganbarimasu.",
        "id": "Terima kasih. Minggu depan mulai kerja. Saya akan berusaha."
      }
    ]
  },
  "grammar": {

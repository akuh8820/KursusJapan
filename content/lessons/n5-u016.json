  "dialog": {
    "title_id": "Rian dan Mina rencanakan liburan ke Kyoto",
    "lines": [
      {
        "speaker": "Rian",
        "jp": "つぎのやすみ、きょうとにいきましょうか。",
        "kana": "つぎのやすみ、きょうとにいきましょうか。",
        "romaji": "Tsugi no yasumi, Kyouto ni ikimashou ka.",
        "id": "Liburan depan, mau ke Kyoto?"
      },
      {
        "speaker": "Mina",
        "jp": "いいですね。きょうとにはおてらがたくさんありますよ。",
        "kana": "いいですね。きょうとにはおてらがたくさんありますよ。",
        "romaji": "Ii desu ne. Kyouto ni wa otera ga takusan arimasu yo.",
        "id": "Bagus. Di Kyoto banyak kuil."
      },
      {
        "speaker": "Rian",
        "jp": "きんかくじにいきたいです。きれいですから。",
        "kana": "きんかくじにいきたいです。きれいですから。",
        "romaji": "Kinkaku-ji ni ikitai desu. Kirei desu kara.",
        "id": "Mau ke Kinkaku-ji. Karena indah."
      },
      {
        "speaker": "Mina",
        "jp": "わたしもいきます。しんかんせんでいきましょう。",
        "kana": "わたしもいきます。しんかんせんでいきましょう。",
        "romaji": "Watashi mo ikimasu. Shinkansen de ikimashou.",
        "id": "Saya juga ikut. Naik Shinkansen ya."
      },
      {
        "speaker": "Rian",
        "jp": "しんかんせんははやいですが、たかいです。",
        "kana": "しんかんせんははやいですが、たかいです。",
        "romaji": "Shinkansen wa hayai desu ga, takai desu.",
        "id": "Shinkansen cepat tapi mahal."
      },
      {
        "speaker": "Mina",
        "jp": "バスでいきましょうか。やすいですから。",
        "kana": "バスでいきましょうか。やすいですから。",
        "romaji": "Basu de ikimashou ka. Yasui desu kara.",
        "id": "Mau naik bus aja? Karena murah."
      },
      {
        "speaker": "Rian",
        "jp": "そうですね。バスでいきましょう。りょこうのつもりです。",
        "kana": "そうですね。バスでいきましょう。りょこうのつもりです。",
        "romaji": "Sou desu ne. Basu de ikimashou. Ryokou no tsumori desu.",
        "id": "Setuju. Naik bus ya. Rencananya liburan."
      }
    ]
  },

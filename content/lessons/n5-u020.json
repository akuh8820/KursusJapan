  "dialog": {
    "title_id": "Rian, Mina, Yuki ikut festival musim panas (natsu matsuri)",
    "lines": [
      {
        "speaker": "Yuki",
        "jp": "なつまつり、たのしみですね。",
        "kana": "なつまつり、たのしみですね。",
        "romaji": "Natsu matsuri, tanoshimi desu ne.",
        "id": "Festival musim panas, seru ya."
      },
      {
        "speaker": "Rian",
        "jp": "うん。よるはなつまつりにいきます。",
        "kana": "うん。よるはなつまつりにいきます。",
        "romaji": "Un. Yoru wa natsu matsuri ni ikimasu.",
        "id": "Ya. Malam ke festival musim panas."
      },
      {
        "speaker": "Mina",
        "jp": "なつまつりのとき、ゆかたをきますか。",
        "kana": "なつまつりのとき、ゆかたをきますか。",
        "romaji": "Natsu matsuri no toki, yukata o kimasu ka.",
        "id": "Saat festival, pakai yukata?"
      },
      {
        "speaker": "Rian",
        "jp": "はい、きます。ゆかたはかっこいいですから。",
        "kana": "はい、きます。ゆかたはかっこいいですから。",
        "romaji": "Hai, kimasu. Yukata wa kakkoii desu kara.",
        "id": "Ya, pakai. Yukata keren kan."
      },
      {
        "speaker": "Yuki",
        "jp": "ひとがおおいかもしれません。はやくいきましょう。",
        "kana": "ひとがおおいかもしれません。はやくいきましょう。",
        "romaji": "Hito ga ooi kamoshiremasen. Hayaku ikimashou.",
        "id": "Mungkin orang banyak. Ayo cepat pergi."
      },
      {
        "speaker": "Mina",
        "jp": "はなびもあるかもしれませんね。",
        "kana": "はなびもあるかもしれませんね。",
        "romaji": "Hanabi mo aru kamoshiremasen ne.",
        "id": "Mungkin ada kembang api juga."
      },
      {
        "speaker": "Rian",
        "jp": "わくわくします。いっしょにたのしみましょう。",
        "kana": "わくわくします。いっしょにたのしみましょう。",
        "romaji": "Wakuwaku shimasu. Issho ni tanoshimimashou.",
        "id": "Saya excited. Ayo nikmati bersama."
      }
    ]
  },

  "dialog": {
    "title_id": "Rian dan Mina bercerita tentang perasaan setelah ujian JLPT",
    "lines": [
      {
        "speaker": "Rian",
        "jp": "しけんがおわって、ほっとしました。",
        "kana": "しけんがおわって、ほっとしました。",
        "romaji": "Shiken ga owatte, hottoshimashita.",
        "id": "Ujian selesai, saya lega."
      },
      {
        "speaker": "Mina",
        "jp": "よかったですね。わたしはまだしんぱいがっています。",
        "kana": "よかったですね。わたしはまだしんぱいがっています。",
        "romaji": "Yokatta desu ne. Watashi wa mada shinpai gatte imasu.",
        "id": "Bagus ya. Saya masih kelihatannya cemas."
      },
      {
        "speaker": "Rian",
        "jp": "だいじょうぶですよ。よくべんきょうしたのに、なぜしんぱいですか。",
        "kana": "だいじょうぶですよ。よくべんきょうしたのに、なぜしんぱいですか。",
        "romaji": "Daijoubu desu yo. Yoku benkyou shita noni, naze shinpai desu ka.",
        "id": "Tidak apa. Kamu belajar keras kan, kenapa cemas?"
      },
      {
        "speaker": "Mina",
        "jp": "リスニングがむずかしかったのに、よみはできました。",
        "kana": "リスニングがむずかしかったのに、よみはできました。",
        "romaji": "Risuningu ga muzukashikatta noni, yomi wa dekimashita.",
        "id": "Listening sulit tapi reading bisa."
      },
      {
        "speaker": "Rian",
        "jp": "それはすごいです。じしんをもってください。",
        "kana": "それはすごいです。じしんをもってください。",
        "romaji": "Sore wa sugoi desu. Jishin wo motte kudasai.",
        "id": "Itu hebat. Miliki kepercayaan diri."
      },
      {
        "speaker": "Mina",
        "jp": "ありがとう。けっかがたのしみです。うれしいきもちです。",
        "kana": "ありがとう。けっかがたのしみです。うれしいきもちです。",
        "romaji": "Arigatou. Kekka ga tanoshimi desu. Ureshii kimochi desu.",
        "id": "Terima kasih. Hasilnya ditunggu. Perasaan senang."
      },
      {
        "speaker": "Rian",
        "jp": "いっしょにおいわいしましょう。ごちそうしますよ。",
        "kana": "いっしょにおいわいしましょう。ごちそうしますよ。",
        "romaji": "Issho ni oiwai shimashou. Gochisou shimasu yo.",
        "id": "Yuk rayakan bersama. Saya treat."
      }
    ]
  },

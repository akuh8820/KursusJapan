  "dialog": {
    "title_id": "Rian dan Mina naik kereta ke Shibuya",
    "lines": [
      {
        "speaker": "Rian",
        "jp": "みなさん、しぶやにいきますか。",
        "kana": "みなさん、しぶやにいきますか。",
        "romaji": "Minasan, Shibuya ni ikimasu ka.",
        "id": "Semua, ke Shibuya ya?"
      },
      {
        "speaker": "Mina",
        "jp": "はい、しぶやえきまで、でんしゃでいきます。",
        "kana": "はい、しぶやえきまで、でんしゃでいきます。",
        "romaji": "Hai, Shibuya-eki made, densha de ikimasu.",
        "id": "Ya, ke stasiun Shibuya naik kereta."
      },
      {
        "speaker": "Rian",
        "jp": "いま、なんじですか。",
        "kana": "いま、なんじですか。",
        "romaji": "Ima, nanji desu ka.",
        "id": "Sekarang jam berapa?"
      },
      {
        "speaker": "Mina",
        "jp": "ろくじはんです。つぎのでんしゃは、ろくじよんじゅうごふんです。",
        "kana": "ろくじはんです。つぎのでんしゃは、ろくじよんじゅうごふんです。",
        "romaji": "Rokuji-han desu. Tsugi no densha wa, rokuji yonjuugo-fun desu.",
        "id": "Jam 6:30. Kereta berikutnya jam 6:45."
      },
      {
        "speaker": "Rian",
        "jp": "いそぎましょう。きっぷはどこでかいますか。",
        "kana": "いそぎましょう。きっぷはどこでかいますか。",
        "romaji": "Isogimashou. Kippu wa doko de kaimasu ka.",
        "id": "Ayo cepat. Tiket beli di mana?"
      },
      {
        "speaker": "Mina",
        "jp": "あのきっぷうりばで。いちまい、にひゃくえんです。",
        "kana": "あのきっぷうりばで。いちまい、にひゃくえんです。",
        "romaji": "Ano kippu-uriba de. Ichimai, nihyaku en desu.",
        "id": "Di penjual tiket sana. Satu lembar 200 yen."
      },
      {
        "speaker": "Rian",
        "jp": "わかりました。ふたりでよんひゃくえんですね。",
        "kana": "わかりました。ふたりでよんひゃくえんですね。",
        "romaji": "Wakarimashita. Futari de yonhyaku en desu ne.",
        "id": "Paham. Berdua 400 yen ya."
      }
    ]
  },

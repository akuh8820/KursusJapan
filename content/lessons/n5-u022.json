  "dialog": {
    "title_id": "Rian di bank menabung dan di pos mengirim paket ke Indonesia",
    "lines": [
      {
        "speaker": "Rian",
        "jp": "すみません、ここにおかねをあずけたいです。",
        "kana": "すみません、ここにおかねをあずけたいです。",
        "romaji": "Sumimasen, koko ni okane wo azuketai desu.",
        "id": "Permisi, saya ingin menabung di sini."
      },
      {
        "speaker": "Ginkou",
        "jp": "かしこまりました。いくらあずけますか。",
        "kana": "かしこまりました。いくらあずけますか。",
        "romaji": "Kashikomarimashita. Ikura azukemasu ka.",
        "id": "Baik. Berapa jumlah yang ingin ditabung?"
      },
      {
        "speaker": "Rian",
        "jp": "いちまんえんあずけます。ざんだかをしりたいです。",
        "kana": "いちまんえんあずけます。ざんだかをしりたいです。",
        "romaji": "Ichiman en azukemasu. Zandaka wo shiritai desu.",
        "id": "Saya menabung 10.000 yen. Saya ingin tahu saldo."
      },
      {
        "speaker": "Ginkou",
        "jp": "ざんだかはさんまんえんです。カードをおつくりになりますか。",
        "kana": "ざんだかはさんまんえんです。カードをおつくりになりますか。",
        "romaji": "Zandaka wa sanman en desu. Kaado wo otsukuri ni narimasu ka.",
        "id": "Saldo 30.000 yen. Apakah ingin buat kartu?"
      },
      {
        "speaker": "Rian",
        "jp": "はい、つくってもいいですか。",
        "kana": "はい、つくってもいいですか。",
        "romaji": "Hai, tsukutte mo ii desu ka.",
        "id": "Ya, boleh buatkan?"
      },
      {
        "speaker": "Ginkou",
        "jp": "もちろんです。つぎはゆうびんきょくですか。",
        "kana": "もちろんです。つぎはゆうびんきょくですか。",
        "romaji": "Mochiron desu. Tsugi wa yuubinkyoku desu ka.",
        "id": "Tentu. Berikutnya ke pos?"
      },
      {
        "speaker": "Rian",
        "jp": "はい、インドネシアににもつをおくります。",
        "kana": "はい、インドネシアににもつをおくります。",
        "romaji": "Hai, Indoneshia ni nimotsu wo okurimasu.",
        "id": "Ya, saya kirim paket ke Indonesia."
      }
    ]
  },

  "dialog": {
    "title_id": "Rian sakit perut, ke klinik dekat kos",
    "lines": [
      {
        "speaker": "Doctor",
        "jp": "こんにちは。どこがいたいですか。",
        "kana": "こんにちは。どこがいたいですか。",
        "romaji": "Konnichiwa. Doko ga itai desu ka.",
        "id": "Selamat siang. Mana yang sakit?"
      },
      {
        "speaker": "Rian",
        "jp": "おなかがいたいです。けさからです。",
        "kana": "おなかがいたいです。けさからです。",
        "romaji": "Onaka ga itai desu. Kesa kara desu.",
        "id": "Perut sakit. Sejak tadi pagi."
      },
      {
        "speaker": "Doctor",
        "jp": "ねつはありますか。",
        "kana": "ねつはありますか。",
        "romaji": "Netsu wa arimasu ka.",
        "id": "Ada demam?"
      },
      {
        "speaker": "Rian",
        "jp": "いいえ、ねつはありません。",
        "kana": "いいえ、ねつはありません。",
        "romaji": "Iie, netsu wa arimasen.",
        "id": "Tidak, tidak demam."
      },
      {
        "speaker": "Doctor",
        "jp": "じゃあ、このくすりをのんでください。しょくごさんかいです。",
        "kana": "じゃあ、このくすりをのんでください。しょくごさんかいです。",
        "romaji": "Jaa, kono kusuri o nonde kudasai. Shokugo sankai desu.",
        "id": "Kalau begitu, minum obat ini. 3 kali sehari setelah makan."
      },
      {
        "speaker": "Rian",
        "jp": "わかりました。みずでのみます。",
        "kana": "わかりました。みずでのみます。",
        "romaji": "Wakarimashita. Mizu de nomimasu.",
        "id": "Paham. Saya minum dengan air."
      },
      {
        "speaker": "Doctor",
        "jp": "だいじょうぶですよ。やすみてくださいね。",
        "kana": "だいじょうぶですよ。やすみてくださいね。",
        "romaji": "Daijoubu desu yo. Yasumite kudasai ne.",
        "id": "Tidak apa-apa. Istirahat yang cukup ya."
      }
    ]
  },
